<title>Anurag</title
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    min-height:100vh;
    font-family:Arial, sans-serif;
    color:white;
    overflow-x:hiddn;

    background:
    radial-gradient(circle at 20% 10%, #8b2cff55, transparent 30%),
    radial-gradient(circle at 90% 60%, #ff2ca655, transparent 30%),
    linear-gradient(135deg,#080014,#21003a,#090014);
}


/* Floating lights */

.light{
    position:fixed;
    width:7px;
    height:7px;
    background:white;
    border-radius:50%;
    opacity:.5;
    pointer-events:none;
    animation:float 7s infinite ease-in-out;
}

.light:nth-child(1){
    left:10%;
    top:20%;
}

.light:nth-child(2){
    left:80%;
    top:25%;
    animation-delay:2s;
}

.light:nth-child(3){
    left:45%;
    top:70%;
    animation-delay:4s;
}

.light:nth-child(4){
    left:20%;
    top:85%;
    animation-delay:1s;
}

@keyframes float{

    0%,100%{
        transform:translateY(0);
        opacity:.2;
    }

    50%{
        transform:translateY(-80px);
        opacity:.9;
    }
}


/* Header */

header{
    text-align:center;
    padding:55px 20px 25px;
}

header h1{

    font-size:55px;

    background:
    linear-gradient(
        90deg,
        #ff82d8,
        #ffffff,
        #b99aff,
        #ff82d8
    );

    background-size:300%;

    -webkit-background-clip:text;
    background-clip:text;

    color:transparent;

    animation:shine 5s linear infinite;
}

@keyframes shine{

    0%{
        background-position:0%;
    }

    100%{
        background-position:300%;
    }
}

header p{

    margin-top:12px;

    font-size:17px;

    color:#dfc7eb;
}


/* Profile section */

.profile{

    text-align:center;

    padding:25px 20px 35px;
}


/* YOUR PHOTO */

.profile-photo{

    width:165px;
    height:165px;

    object-fit:cover;

    border-radius:50%;

    border:5px solid white;

    display:block;

    margin:auto;

    box-shadow:
        0 0 15px #ffffff,
        0 0 35px #ff45c8,
        0 0 70px #7b4dff;

    animation:
        photoGlow 3s infinite alternate,
        photoFloat 4s infinite ease-in-out;
}


@keyframes photoGlow{

    from{

        box-shadow:
        0 0 15px #ffffff,
        0 0 30px #ff45c8,
        0 0 55px #7b4dff;
    }

    to{

        box-shadow:
        0 0 20px #ffffff,
        0 0 45px #ff45c8,
        0 0 85px #7b4dff;
    }
}


@keyframes photoFloat{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-8px);
    }
}


.profile h2{

    margin-top:20px;

    font-size:32px;

    color:white;
}

.profile h2 span{

    color:#ff9ddd;
}


.profile p{

    margin-top:9px;

    color:#d8bfdf;

    font-size:16px;
}


/* Shayari area */

.container{

    width:92%;

    max-width:850px;

    margin:auto;
}


/* Shayari card */

.card{

    position:relative;

    overflow:hidden;

    margin:22px 0;

    padding:32px 22px;

    text-align:center;

    border-radius:25px;

    background:rgba(255,255,255,.09);

    border:1p
    background:#ff42c8;
    filter:blur(80px)

    opacity:.18

    top:-70px
    lef


.card:hover{

    trnsform:
        translateY(-8px)
        scale(1.01);

      0 20px 55px #ff43c833;
}


@keyframes cardAppear{

    from{

        opacity:0;

        transform:translateY(35px);
    }

    to{

        opacity:1;

        transform:translateY(0);
    }
}


/* Emoji */

.icon{

    font-size:38px;

    margin-bottom:12px;

    animation:heartbeat 1.8s infinite;
}


@keyframes heartbeat{

    0%,100%{
        transform:scale(1);
    }

    50%{
        transform:scale(1.18);
    }
}


.card h3{

    color:#ffb6e7;

    font-size:25px;

    margin-bottom:15px;
}


.card p{

    font-size:19px;

    line-height:1.9;

    color:#ffffff;
}


/* Button */

.button{

    display:inline-block;

    margin-top:20px;

    padding:12px 28px;

    border-radius:30px;

    color:white;

    text-decoration:none;

    background:
    linear-gradient(
        90deg,
        #ff3db8,
        #714cff
    );

    box-shadow:
        0 8px 25px #ff3db844;

    transition:.3s;
}


.button:hover{

    transform:translateY(-4px)
    padding:45px 15px 25px;

    color:#bca7c5;

    font-size:14px;
}


footer strong{

    color:#ff9ddd;
}


/* Mobile */

@media(max-width:600px){

    header h1{
        font-size:43px;
    }

    .profile-photo{
        width:145px;
        height:145px;
    }

    .card p{
        font-size:18px;
    }

}

</style>
</head>


