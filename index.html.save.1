/* Shayari card */

.card{

    position:relative;

    overflow:hidden;

    margin:22px 0;

    padding:32px 22px;

    text-align:center;

    border-radius:25px;

    background:rgba(255,255,255,.09);

    border:1px solid rgba(255,255,255,.18);

    backdrop-filter:blur(14px);

    box-shadow:
        0 15px 40px rgba(0,0,0,.35);

    transition:.4s;

    animation:cardAppear 1s ease;
}


.card::before{

    content:"";

    position:absolute;

    width:150px;
    height:150px;

    background:#ff42c8;

    filter:blur(80px);

    opacity:.18;

    top:-70px;
    left:-60px;
}


.card:hover{

    transform:
        translateY(-8px)
        scale(1.01);

    border-color:#ff9ddd;

    box-shadow:
        0 20px 55px #ff43c833;
}


@keyframes cardAppear{

    from{

        opacity:0;

        transform:translateY(35px);
    }

    to{

        opacity:1;

        transform:translateY(0);
    }
}


/* Emoji */

.icon{

    font-size:38px;

    margin-bottom:12px;

    animation:heartbeat 1.8s infinite;
}


@keyframes heartbeat{

    0%,100%{
        transform:scale(1);
    }

    50%{
        transform:scale(1.18);
    }
}


.card h3{

